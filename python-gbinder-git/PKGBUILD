pkgname=python-gbinder-git
pkgdesc="Python libgbinder bindings"
pkgver=1.3.1
pkgrel=1
arch=('x86_64')
url="https://github.com/waydroid/gbinder-python"
depends=('libgbinder')
conflicts=('python-gbinder')
replaces=('python-gbinder')
provides=("python-gbinder=$pkgver")
makedepends=('python-build' 'cython' 'python-installer' 'python-wheel' 'python-setuptools' 'git')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    git describe --tags --abbrev=0 | sed 's/^v//'
}

prepare() {
    cd "$srcdir/$pkgname"
    cython -a gbinder.pyx
}

build() {
    cd "$srcdir/$pkgname"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
