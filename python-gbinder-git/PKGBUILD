pkgname=python-gbinder-git
pkgdesc="Python libgbinder bindings"
pkgver=1.3.1
pkgrel=1
arch=('x86_64')
url="https://github.com/waydroid/gbinder-python"
depends=('libgbinder')
conflicts=('python-gbinder')
replaces=('python-gbinder')
provides=('python-gbinder')
makedepends=('python-build' 'cython' 'python-installer' 'python-wheel' 'python-setuptools' 'python-wheel' 'git')
source=(git+${url}.git)
sha256sums=('SKIP')

pkgver() {
    cd gbinder-python
    git describe --tags --abbrev=0 | sed 's/^v//'
}

prepare() {
    cd gbinder-python
    git -C "${srcdir}/gbinder-python" clean -dfx
    cython -a gbinder.pyx
}

build() {
    cd gbinder-python
    python -m build --wheel --no-isolation
}

package() {
    cd gbinder-python
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/pytnon-gbinder/LICENSE"
}
